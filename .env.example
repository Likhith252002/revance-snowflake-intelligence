# Revance Practice Intelligence Pipeline — credentials template
#
# This project currently reads Snowflake credentials from `config.py` (git-ignored).
# Copy the values below into a new `config.py` like this:
#
#   SNOWFLAKE_CONFIG = {
#       "account":   "<SNOWFLAKE_ACCOUNT>",
#       "user":      "<SNOWFLAKE_USER>",
#       "password":  "<SNOWFLAKE_PASSWORD>",
#       "warehouse": "<SNOWFLAKE_WAREHOUSE>",
#       "database":  "<SNOWFLAKE_DATABASE>",
#       "schema":    "<SNOWFLAKE_SCHEMA>",
#       "role":      "<SNOWFLAKE_ROLE>",
#   }
#
# Never commit a populated config.py — it is listed in .gitignore.

SNOWFLAKE_ACCOUNT=your-account-locator
SNOWFLAKE_USER=your-username
SNOWFLAKE_PASSWORD=your-password
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=SNOWFLAKE_LEARNING_DB
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=ACCOUNTADMIN
